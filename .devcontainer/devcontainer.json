{
  "name": "netlane",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=netlane-bashhistory,target=/commandhistory,type=volume"
  ],
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "sudo chown -R $(whoami): /commandhistory && uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-pyright.pyright",
        "ms-python.black-formatter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
